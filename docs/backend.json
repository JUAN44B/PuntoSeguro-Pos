{
    "entities": {
        "product": {
            "title": "Product",
            "description": "Represents a product in the inventory.",
            "type": "object",
            "properties": {
                "id": { "type": "string" },
                "code": { "type": "string" },
                "name": { "type": "string" },
                "status": { "type": "string", "enum": ["Activo", "Borrador", "Archivado"] },
                "purchasePrice": { "type": "number" },
                "discount": { "type": "number" },
                "profitMargin": { "type": "number" },
                "finalPrice": { "type": "number" },
                "stock": { "type": "number" },
                "category": { "type": "string" },
                "image": { "type": "string" }
            },
            "required": ["name", "finalPrice", "stock"]
        },
        "userProfile": {
            "title": "User Profile",
            "description": "Represents a user's profile.",
            "type": "object",
            "properties": {
                "uid": { "type": "string" },
                "email": { "type": "string" },
                "displayName": { "type": "string" },
                "role": { "type": "string", "enum": ["Administrador", "Cajero", "Supervisor"] }
            },
            "required": ["uid", "email", "role"]
        },
        "category": {
            "title": "Category",
            "description": "Represents a product category.",
            "type": "object",
            "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" }
            },
            "required": ["name"]
        },
        "client": {
            "title": "Client",
            "description": "Represents a customer.",
            "type": "object",
            "properties": {
                "name": { "type": "string" },
                "phone": { "type": "string" },
                "email": { "type": "string" },
                "address": { "type": "string" }
            },
            "required": ["name"]
        },
        "sale": {
            "title": "Sale",
            "description": "Represents a completed sale transaction.",
            "type": "object",
            "properties": {
                "saleId": { "type": "string" },
                "createdAt": { "type": "string", "format": "date-time" },
                "items": { 
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" },
                            "price": { "type": "number" },
                            "quantity": { "type": "number" }
                        },
                        "required": ["id", "name", "price", "quantity"]
                    }
                },
                "total": { "type": "number" },
                "subtotal": { "type": "number" },
                "iva": { "type": "number" },
                "paymentMethod": { "type": "string" }
            },
            "required": ["saleId", "createdAt", "items", "total"]
        }
    },
    "firestore": {
        "/products/{productId}": {
            "schema": { "$ref": "#/entities/product" },
            "description": "Stores individual product details."
        },
        "/users/{userId}": {
            "schema": { "$ref": "#/entities/userProfile" },
            "description": "Stores user profile information linked to their authentication UID."
        },
        "/categories/{categoryId}": {
            "schema": { "$ref": "#/entities/category" },
            "description": "Stores product categories."
        },
        "/clients/{clientId}": {
            "schema": { "$ref": "#/entities/client" },
            "description": "Stores customer information."
        },
        "/sales/{saleId}": {
            "schema": { "$ref": "#/entities/sale" },
            "description": "Stores completed sale transactions."
        }
    },
    "auth": {
        "providers": ["password"]
    }
}
