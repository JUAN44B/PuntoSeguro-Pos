{
    "entities": {
        "product": {
            "title": "Product",
            "description": "Represents a product in the inventory.",
            "type": "object",
            "properties": {
                "id": { "type": "string" },
                "code": { "type": "string" },
                "name": { "type": "string" },
                "status": { "type": "string", "enum": ["Activo", "Borrador", "Archivado"] },
                "purchasePrice": { "type": "number" },
                "discount": { "type": "number" },
                "profitMargin": { "type": "number" },
                "finalPrice": { "type": "number" },
                "stock": { "type": "number" },
                "category": { "type": "string" },
                "image": { "type": "string" }
            },
            "required": ["name", "finalPrice", "stock"]
        },
        "userProfile": {
            "title": "User Profile",
            "description": "Represents a user's profile.",
            "type": "object",
            "properties": {
                "uid": { "type": "string" },
                "email": { "type": "string" },
                "displayName": { "type": "string" },
                "role": { "type": "string", "enum": ["Administrador", "Cajero", "Supervisor"] }
            },
            "required": ["uid", "email", "role"]
        },
        "category": {
            "title": "Category",
            "description": "Represents a product category.",
            "type": "object",
            "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" }
            },
            "required": ["name"]
        }
    },
    "firestore": {
        "/products/{productId}": {
            "schema": { "$ref": "#/entities/product" },
            "description": "Stores individual product details."
        },
        "/users/{userId}": {
            "schema": { "$ref": "#/entities/userProfile" },
            "description": "Stores user profile information linked to their authentication UID."
        },
        "/categories/{categoryId}": {
            "schema": { "$ref": "#/entities/category" },
            "description": "Stores product categories."
        }
    },
    "auth": {
        "providers": ["password"]
    }
}
